# Core runtime mode: local or cloud
DUCKDB_ENV=local

# Local storage
# DATA_DIR=./data
# LOCAL_DB_PATH=./data/CherryMon.duckdb
# DATAFILE_PATH=./data

# MotherDuck
DB_MOTHERDUCK_PATH=md:CherryMon
MOTHERDUCK_TOKEN=

# CherryStock MCP server
# CHERRYSTOCK_MCP_HOST=127.0.0.1
# CHERRYSTOCK_MCP_PORT=8765
# CHERRYSTOCK_MCP_MAX_QUERY_ROWS=500
# CHERRYSTOCK_MCP_ENABLE_WRITE=true

# Optional overrides
# AGENT_PATH=./.github/agents
# DUCKDB_SQL_PATH=./src/DuckDB/sql
# AMIBROKER_DATABASE_PATH=C:/Program1/AmiBroker/Data_FireAnt/AmiBroker
# AMIBROKER_ROOT=C:/Program1/AmiBroker
# AMIBROKER_LOG_PATH=C:/Program1/AmiBroker/broker.log
# AMIBROKER_AFL_PATH=./src/Amibroker/Formulas/CherryMon
# AMIBROKER_EOD_PATH=C:/Program1/AmiBroker/Data_FireAnt/AmiBroker/EOD
# AMIBROKER_INTRADAY_PATH=C:/Program1/AmiBroker/Data_FireAnt/AmiBroker/Intraday
