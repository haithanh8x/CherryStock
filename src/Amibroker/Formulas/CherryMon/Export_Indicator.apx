<?xml version="1.0" encoding="ISO-8859-1"?>
<AmiBroker-Analysis CompactMode="0">
<General>
<FormatVersion>1</FormatVersion>
<Symbol>AAH</Symbol>
<FormulaPath>C:\\Github\\CherryStock\\src\\Amibroker\\Formulas\\CherryMon\\Export_Indicator.afl</FormulaPath>
<FormulaContent>// CherryStock - Export_Indicator.afl\r\n// Multi-timeframe OHLCV indicator Exploration (D / W / M).\r\n//\r\n// IMPORTANT\r\n// - New Analysis -&gt; Periodicity = DAILY, Apply To = All Symbols.\r\n// - Range in Analysis controls exported daily rows (All quotations for backfill).\r\n// - Timeframes parameter: ALL, D, W, or M. ALL emits suffixed columns for\r\n//   all three timeframes on each daily row; W/M values appear only on the\r\n//   last observed daily bar of each period (expandPoint), never future-filled.\r\n// - Current, unfinished W/M periods may be provisional. The importer must\r\n//   decide whether to accept them; this AFL does not promise period closure.\r\n// - Output is a WIDE, intermediate CSV (not cal_indicator_values). Python must\r\n//   validate/unpivot and resolve ConfigCode/ComponentCode/ConfigId before upsert.\r\n// - No changes to existing DuckDB tables, views, or consumers.\r\n// - Calculations use AmiBroker's OHLCV, which must match CherryStock source.\r\n// - OBV and AD are cumulative; start from the full available source history.\r\n// - VWAP20 here is a 20-bar rolling typical-price-volume weighted proxy, NOT\r\n//   session/transaction VWAP (daily OHLCV cannot reconstruct that).\r\n//\r\n// Default parameters align with known CherryStock configs (MA 20/50/100/200,\r\n// BB 20/2, ATR14, RSI14, OBV, AD) and conventional defaults for the rest.\r\n// AFL vs pandas-ta-classic numeric parity MUST be checked before production.\r\n//\r\n// Intended output names: {ConfigCode}_{ComponentCode} where appropriate,\r\n// suffixed _D, _W, _M. Existing codes are exactly MA20_D, BB20_2_D, etc;\r\n// parser must map multi-component prefixes, not assume every column equals\r\n// an active database ConfigCode.\r\n\r\n// Full source history is essential for cumulative OBV/AD (no QuickAFL truncation).\r\nSetBarsRequired( sbrAll, sbrAll );\r\nSetOption( "NoDefaultColumns", True );\r\n\r\nx_tfSelection = ParamList( "Timeframes", "ALL|D|W|M", 0 );\r\n// Do not default to a named AmiBroker group: database group labels vary.\r\nx_onlyStocks = ParamToggle( "Symbol filter", "All symbols|Gia co phieu", 0 );\r\nx_exportMode = ParamList( "Export mode", "FULL|INCREMENTAL", 1 );\r\nx_exportDays = Param( "Incremental trading bars", 10, 1, 365, 1 );\r\n\r\n// The New Analysis Apply-to setting independently selects the ticker universe.\r\n// Here we only restrict OUTPUT rows, keeping all history for indicators.\r\nx_universeFilter = IIf( x_onlyStocks, GroupID(1) == "Gia co phieu", 1 );\r\nx_recentBars = BarIndex() &gt;= Max( 0, BarCount - x_exportDays );\r\nFilter = x_universeFilter AND IIf( x_exportMode == "INCREMENTAL", x_recentBars, 1 );\r\n\r\nAddTextColumn( Name(), "Ticker" );\r\nAddColumn( DateTime(), "Date", formatDateTimeISO );\r\n\r\nfunction CS_ExpandPoint( src, tf )\r\n{\r\n    // AFL requires the return statement at the very end of the function.\r\n    if( tf == inDaily )\r\n        x_expanded = src;\r\n    else\r\n        x_expanded = TimeFrameExpand( src, tf, expandPoint );\r\n\r\n    return x_expanded;\r\n}\r\n\r\nprocedure CS_ExportIndicators( tf, suffix, yearBars )\r\n{\r\n    // Requires DAILY base periodicity in New Analysis.\r\n    if( tf != inDaily )\r\n        TimeFrameSet( tf );\r\n\r\n    // 1. Moving averages: CherryStock's known MA20/50/100/200 configs.\r\n    x_ma20  = MA( C, 20 );\r\n    x_ma50  = MA( C, 50 );\r\n    x_ma100 = MA( C, 100 );\r\n    x_ma200 = MA( C, 200 );\r\n\r\n    // 2. Bollinger Bands (20, 2): same five component semantics as CherryStock.\r\n    x_bbMiddle  = x_ma20;\r\n    x_bbUpper   = BBandTop( C, 20, 2 );\r\n    x_bbLower   = BBandBot( C, 20, 2 );\r\n    x_bbSpread  = x_bbUpper - x_bbLower;\r\n    x_bbWidth   = IIf( x_bbMiddle != 0, 100 * x_bbSpread / x_bbMiddle, Null );\r\n    x_bbPercent = IIf( x_bbSpread != 0, ( C - x_bbLower ) / x_bbSpread, Null );\r\n\r\n    // 3. Volatility and momentum.\r\n    x_atr14 = ATR( 14 );\r\n    x_rsi14 = RSI( 14 );\r\n    x_obv   = OBV();\r\n    x_ad    = AccDist();\r\n\r\n    x_macdLine   = MACD( 12, 26 );\r\n    x_macdSignal = Signal( 12, 26, 9 );\r\n    x_macdHist   = x_macdLine - x_macdSignal;\r\n\r\n    // 4. Additional trend measures.\r\n    x_ema9   = EMA( C, 9 );\r\n    x_ema21  = EMA( C, 21 );\r\n    x_ema50  = EMA( C, 50 );\r\n    x_ema200 = EMA( C, 200 );\r\n    x_adx14  = ADX( 14 );\r\n    x_pdi14  = PDI( 14 );\r\n    x_mdi14  = MDI( 14 );\r\n\r\n    // 5. Rate of Change (percent).\r\n    x_roc5  = ROC( C, 5 );\r\n    x_roc10 = ROC( C, 10 );\r\n    x_roc20 = ROC( C, 20 );\r\n\r\n    // 6. Volume moving averages and relative volume ratio.\r\n    x_volMa20    = MA( V, 20 );\r\n    x_volMa50    = MA( V, 50 );\r\n    x_volRatio20 = IIf( x_volMa20 &gt; 0, V / Max( x_volMa20, 0.00000001 ), Null );\r\n\r\n    // 7. Approximately 52-week price extremes using bars of this timeframe.\r\n    // D = 252 trading days, W = 52 weeks, M = 12 months.\r\n    x_high52w = HHV( H, yearBars );\r\n    x_low52w  = LLV( L, yearBars );\r\n\r\n    // 8. Slow Stochastic (14,3,3); %K already includes 3-bar smoothing.\r\n    x_stochK = StochK( 14, 3 );\r\n    x_stochD = StochD( 14, 3, 3 );\r\n\r\n    // 9. Money Flow Index, Chaikin Money Flow.\r\n    x_mfi14     = MFI( 14 );\r\n    x_hlRange   = H - L;\r\n    x_mfMult    = IIf( x_hlRange &gt; 0, ( 2 * C - H - L ) / Max( x_hlRange, 0.00000001 ), 0 );\r\n    x_volSum20  = Sum( V, 20 );\r\n    x_cmf20     = IIf( x_volSum20 &gt; 0, Sum( x_mfMult * V, 20 ) / Max( x_volSum20, 0.00000001 ), Null );\r\n\r\n    // 10. Rolling VWAP20 approximation from typical price and bar volume.\r\n    // NOT intraday session-anchored VWAP.\r\n    x_typical = ( H + L + C ) / 3;\r\n    x_vwap20  = IIf( x_volSum20 &gt; 0, Sum( x_typical * V, 20 ) / Max( x_volSum20, 0.00000001 ), Null );\r\n\r\n    if( tf != inDaily )\r\n        TimeFrameRestore();\r\n\r\n    // Export after restoring base daily periodicity. The expandPoint mode\r\n    // leaves W/M cells empty except on their period's final OBSERVED bar.\r\n    AddColumn( CS_ExpandPoint( x_ma20, tf ),         "MA20_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_ma50, tf ),         "MA50_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_ma100, tf ),        "MA100_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_ma200, tf ),        "MA200_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_bbLower, tf ),      "BB20_2_LOWER_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_bbMiddle, tf ),     "BB20_2_MIDDLE_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_bbUpper, tf ),      "BB20_2_UPPER_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_bbWidth, tf ),      "BB20_2_WIDTH_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_bbPercent, tf ),    "BB20_2_PERCENT_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_atr14, tf ),        "ATR14_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_rsi14, tf ),        "RSI14_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_obv, tf ),          "OBV_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_ad, tf ),           "AD_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_macdLine, tf ),     "MACD12_26_9_LINE_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_macdSignal, tf ),   "MACD12_26_9_SIGNAL_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_macdHist, tf ),     "MACD12_26_9_HIST_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_ema9, tf ),         "EMA9_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_ema21, tf ),        "EMA21_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_ema50, tf ),        "EMA50_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_ema200, tf ),       "EMA200_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_adx14, tf ),        "ADX14_ADX_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_pdi14, tf ),        "ADX14_PLUS_DI_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_mdi14, tf ),        "ADX14_MINUS_DI_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_roc5, tf ),         "ROC5_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_roc10, tf ),        "ROC10_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_roc20, tf ),        "ROC20_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_volMa20, tf ),      "VOL_MA20_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_volMa50, tf ),      "VOL_MA50_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_volRatio20, tf ),   "VOL_RATIO20_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_high52w, tf ),      "HIGH52W_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_low52w, tf ),       "LOW52W_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_stochK, tf ),       "STOCH14_3_3_K_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_stochD, tf ),       "STOCH14_3_3_D_" + suffix, 1.6 );\r\n\r\n    AddColumn( CS_ExpandPoint( x_mfi14, tf ),        "MFI14_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_cmf20, tf ),        "CMF20_" + suffix, 1.6 );\r\n    AddColumn( CS_ExpandPoint( x_vwap20, tf ),       "VWAP20_" + suffix, 1.6 );\r\n}\r\n\r\n// One AFL; select ALL for 3 timeframes, or D/W/M for lighter exports.\r\n// These are all derived from the same Daily AmiBroker OHLCV source.\r\nif( x_tfSelection == "ALL" OR x_tfSelection == "D" )\r\n    CS_ExportIndicators( inDaily, "D", 252 );\r\n\r\nif( x_tfSelection == "ALL" OR x_tfSelection == "W" )\r\n    CS_ExportIndicators( inWeekly, "W", 52 );\r\n\r\nif( x_tfSelection == "ALL" OR x_tfSelection == "M" )\r\n    CS_ExportIndicators( inMonthly, "M", 12 );\r\n</FormulaContent>
