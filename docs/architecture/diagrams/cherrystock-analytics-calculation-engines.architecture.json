  "cards": [
    {"dot": "emerald", "title": "Daily analytics transaction", "items": ["Target order: Composite Index → Trend/MA → Indicator Engine → Price Movement Character → SmartMoneyScore", "Price Movement consumes adjusted OHLC plus public ATR evidence and preserves confirmed vs provisional swing semantics", "Each calculated write is followed by blocking Data Quality in the shared DuckDBUnitOfWork; failure before commit rolls back the write set"]},
    {"dot": "cyan", "title": "Calculation contracts", "items": ["Composite Index writes cal_Indexes; Trend/MA writes cal_Trends", "Indicator Engine persists long-format cal_indicator_values and exposes vw_Ticker_indicators / vw_Indicator_config", "Price Movement persists confirmed swing events + daily as-of state and exposes swing/daily/profile views", "SmartMoney persists factor + ticker score tables and exposes vw_Ticker_SmartMoney"]},
    {"dot": "violet", "title": "Independent analytical paths", "items": ["Price Movement Character is additive and does not change SmartMoneyScore V1; future consumption requires a separate approved requirement", "Runtime R/S Level Ladder is read/on-demand analytical calculation using market data plus Indicator public contracts", "Monthly R/S V2.4 is a separate research path: baseline/ablation → Source Effectiveness → Promotion Gate and does not auto-change runtime weights"]}
  ]
