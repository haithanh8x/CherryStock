  "cards": [
    {"dot": "emerald", "title": "Daily analytics transaction", "items": ["Canonical order: Composite Index → Trend/MA → Indicator Engine → SmartMoneyScore", "Each calculated write is followed by blocking Data Quality in SyncWritePipelineService", "All daily writes participate in the shared DuckDBUnitOfWork; failure before commit rolls back the write set"]},
    {"dot": "cyan", "title": "Calculation contracts", "items": ["Composite Index writes cal_Indexes; Trend/MA writes cal_Trends", "Indicator Engine persists long-format cal_indicator_values and exposes vw_Ticker_indicators / vw_Indicator_config", "SmartMoney persists factor + ticker score tables and exposes vw_Ticker_SmartMoney"]},
    {"dot": "violet", "title": "R/S is two paths", "items": ["Runtime Level Ladder is read/on-demand analytical calculation using market data plus Indicator public contracts", "Monthly R/S V2.4 is a separate research path: baseline/ablation → Source Effectiveness → Promotion Gate", "V2.4 persists cal_rs_source_effectiveness_run, cal_rs_source_effectiveness, sys_rs_source_promotion_audit and vw_RS_Source_Effectiveness; it does not auto-change runtime weights"]}
  ]
