  "cards": [
    {
      "dot": "cyan",
      "title": "Shared bootstrap for every routed task",
      "items": [
        "1) .github/copilot-instructions.md — repository governance, intent classification, owner selection and handoff rules.",
        "2) .github/agents/CherryMon.agent.md — stable architecture constitution, module responsibilities and Source-of-Truth principles.",
        "3) Intent-specific *.agent.md — WHO owns the current engineering outcome.",
        "4) Matching .github/instructions/*.instructions.md — HOW that domain must execute safely.",
        "5) docs/00_HOME.md → relevant docs/** → existing source/tests — smallest evidence set needed for the task."
      ]
    },
    {
      "dot": "emerald",
      "title": "BusinessAnalyst.agent.md",
      "items": [
        "Reads: governance + CherryMon + docs/00_HOME.md + existing REQ-* + relevant architecture/ADR/domain policy.",
        "Runs: Frame → Define → Make Testable → Decompose/Route.",
        "Writes: docs/backlog/requirements/REQ-*.md using REQUIREMENT_TEMPLATE.md.",
        "Exits: READY_FOR_DESIGN → SolutionArchitect; READY_FOR_IMPLEMENTATION → GeneralCoding/domain owner; ambiguity stays with BA."
      ]
    },
    {
      "dot": "violet",
      "title": "SolutionArchitect.agent.md",
      "items": [
        "Reads: ready requirement + docs/00_HOME.md + docs/architecture/** + docs/adr/** + domain instructions + source/tests.",
        "Runs: Context → Current State → Proposed Design → Decision Check; Archify represents approved design, never invents it.",
        "Writes: docs/architecture/**, docs/adr/** when required, typed diagrams under docs/architecture/diagrams/** and generated HTML.",
        "Exits only after synchronized Archify validation: APPROVED_FOR_IMPLEMENTATION → GeneralCoding or authoritative domain agent."
      ]
    },
    {
      "dot": "amber",
      "title": "Specialist agents",
      "items": [
        "Indicator_Management.agent.md: Indicator_Engine.md + indicators.instructions.md + legacy Indicator_Engine reference + calcEngine/MCP → metadata → targeted backfill → validation → TestEngineer.",
        "Chart.agent.md: chart.instructions.md + chart-authoring/SKILL.md + Chart_Architecture.md + actual data contract → recommend → Flint spec → validate/render.",
        "Chart advisory may end at the user; production integration hands the approved chart/data contract to GeneralCoding."
      ]
    },
    {
      "dot": "orange",
      "title": "GeneralCoding.agent.md",
      "items": [
        "Reads: clear request/REQ-* or approved design/ADR + matching domain instructions + canonical docs + current code/tests.",
        "Runs: Confirm → Inspect → Implement smallest compatible change → Update Materials → Developer Verification → Handoff.",
        "Writes: src/**, scripts/**, affected tests/docs; optional docs/development/implementation-notes/** when non-obvious.",
        "Exit: IMPLEMENTED_PENDING_VALIDATION. It must never self-declare PASS."
      ]
    },
    {
      "dot": "rose",
      "title": "TestEngineer.agent.md",
      "items": [
        "Reads: testing.instructions.md + requirement/AC + implementation handoff + docs/00_HOME.md + domain policy + architecture/ADR + code/tests/runbooks.",
        "Runs finite state machine: DEFINE → PREPARE → EXECUTE → EVALUATE; retries are bounded and unchanged retries are prohibited.",
        "Writes/records: tests/** and durable runbook/evidence where needed.",
        "Owns terminal verdict: PASS | FAIL | BLOCKED | REGRESSION; routes the defect to BA, SA, implementation/domain owner, or user as appropriate."
      ]
    },
    {
      "dot": "slate",
      "title": "Folder purpose",
      "items": [
        ".github/agents/** = outcome ownership; .github/instructions/** = domain execution policy; .github/skills/** = reusable tool/authoring skills.",
        "docs/backlog/requirements/** = durable requirement contract; docs/architecture/** = system/design Source of Truth; docs/adr/** = durable cross-module decisions.",
        "src/** = runtime implementation; scripts/** = focused execution/migration/backfill/render helpers; tests/** = executable validation.",
        "docs/runbook/** = reproducible operational/test procedure; docs/ChangeRequest/** = change/release traceability; docs/architecture/generated/** = presentation output only."
      ]
    }
  ]
}